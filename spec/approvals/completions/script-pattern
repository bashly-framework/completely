_mygit_completions_node_flag_state() {
  case "$1:$2" in
    1:--bare) return 0 ;;
    2:--branch|2:-b) return 2 ;;
    2:--verbose|2:-v) return 0 ;;
  esac

  return 1
}

_mygit_completions_option_seen() {
  local completed_option option_name
  for completed_option in "${completed_options[@]}"; do
    for option_name in "$@"; do
      [[ "$completed_option" == "$option_name" ]] && return 0
    done
  done

  return 1
}

_mygit_completions_resolve_node() {
  node_id=0
  node_word_count=0
  positional_index=0

  local word
  for word in "${non_options[@]}"; do
    case "$node_id:$word" in
      0:init)
        node_id=1
        node_word_count=1
        ;;
      0:status)
        node_id=2
        node_word_count=1
        ;;
      0:st)
        node_id=2
        node_word_count=1
        ;;
      *)
        break
        ;;
    esac
  done

  positional_index=$((${#non_options[@]} - node_word_count))
}

_mygit_completions() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local prev=
  if ((COMP_CWORD > 0)); then
    prev=${COMP_WORDS[$((COMP_CWORD - 1))]}
  fi

  local completed=()
  if ((COMP_CWORD > 1)); then
    completed=("${COMP_WORDS[@]:1:$((COMP_CWORD - 1))}")
  fi

  local non_options=()
  local completed_options=()
  local node_id=
  local node_word_count=-1
  local positional_index=0
  local invalid_completion=0
  local flag_state=0
  _mygit_completions_resolve_node

  local skip_next=0
  for word in "${completed[@]}"; do
    if ((skip_next)); then
      skip_next=0
      continue
    fi

    if [[ "${word:0:1}" == "-" ]]; then
      _mygit_completions_node_flag_state "$node_id" "$word"
      flag_state=$?
      if (( flag_state == 1 )); then
        invalid_completion=1
        break
      fi

      completed_options+=("$word")
      if (( flag_state == 2 )); then
        skip_next=1
      fi
      continue
    fi

    non_options+=("$word")
    _mygit_completions_resolve_node
  done

  COMPREPLY=()
  (( invalid_completion )) && return

  case "$node_id:$prev" in
    2:--branch|2:-b)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(echo main dev)" -- "$cur")
      return
      ;;
  esac

  if [[ "${cur:0:1}" != "-" ]] && (( positional_index == 0 )); then
    case "$node_id" in
      0)
        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "init status st" -- "$cur")
        return
        ;;
    esac
  fi

  if [[ "${cur:0:1}" == "-" ]]; then
    case "$node_id" in
      0)
        local words=()
        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "${words[*]}" -- "$cur")
        return
        ;;
      1)
        local words=()
        _mygit_completions_option_seen "--bare" || words+=("--bare")
        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "${words[*]}" -- "$cur")
        return
        ;;
      2)
        local words=()
        _mygit_completions_option_seen "--verbose" "-v" || words+=("--verbose" "-v")
        _mygit_completions_option_seen "--branch" "-b" || words+=("--branch" "-b")
        while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "${words[*]}" -- "$cur")
        return
        ;;
    esac
  fi

  case "$node_id:$positional_index" in
    1:0)
      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -A directory -- "$cur")
      return
      ;;
  esac
} &&
  complete -F _mygit_completions mygit

